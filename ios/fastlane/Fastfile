require_relative "build_number"
require "base64"

default_platform(:ios)

platform :ios do
  desc "Build and upload a signed Release to TestFlight"
  lane :beta do
    marketing_version = ENV["MARKETING_VERSION"]
    team_id = ENV["APPLE_TEAM_ID"]

    key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8_BASE64"],
      is_key_content_base64: true,
    )

    # Survive the first ever upload: a brand-new app record has no build,
    # so the query raises or returns nothing. next_build_number turns that
    # into 1; otherwise it increments the latest. See build_number.rb.
    build = next_build_number do
      latest_testflight_build_number(
        api_key: key,
        version: marketing_version,
        initial_build_number: 0,
      )
    end

    # gym does not forward the App Store Connect key to xcodebuild's
    # -allowProvisioningUpdates, so automatic signing has no account to create
    # the app-store profiles with ("No Accounts … No profiles for …"). Write the
    # key to a file and pass the auth flags to both the archive and the export.
    key_file = File.join(Dir.pwd, "asc_api_key.p8")
    File.write(key_file, Base64.decode64(ENV["ASC_KEY_P8_BASE64"]))
    auth = "-authenticationKeyPath #{key_file} " \
           "-authenticationKeyID #{ENV['ASC_KEY_ID']} " \
           "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}"

    build_app(
      xcargs: [
        "-allowProvisioningUpdates",
        auth,
        "-skipPackagePluginValidation",
        "MARKETING_VERSION=#{marketing_version}",
        "CURRENT_PROJECT_VERSION=#{build}",
        "DEVELOPMENT_TEAM=#{team_id}",
      ].join(" "),
      export_xcargs: "-allowProvisioningUpdates #{auth}",
    )

    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true,
    )
  end
end
