<?xml version="1.0" encoding="UTF-8"?>
<!-- The Release/TestFlight twin of Matchblox.entitlements: identical but
     aps-environment and the App Attest environment are production. The
     Matchblox target picks this file for its Release config (see
     project.yml); Debug keeps Matchblox.entitlements (development). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(MATCHBLOX_BUNDLE_ID)</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(MATCHBLOX_BUNDLE_ID)</string>
		<string>$(AppIdentifierPrefix)$(MATCHBLOX_BUNDLE_ID).shared</string>
	</array>
</dict>
</plist>
